[Unit]
Description=SpaceMatrix tensor visualization
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/SpaceMatrix
ExecStart=/usr/bin/node /opt/SpaceMatrix/backend/server.js
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3044
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
